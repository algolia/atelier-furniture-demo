{
  "name": "color-hierarchy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Furniture demo SPA built with vanilla InstantSearch.js, featuring a custom multi-level color hierarchy widget",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "node scripts/generate-records.mjs",
