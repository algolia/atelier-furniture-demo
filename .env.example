# Copy to .env and fill in. Only the SEARCH-ONLY key belongs in VITE_ vars —
# anything prefixed VITE_ is bundled into the client JS.
VITE_ALGOLIA_APP_ID=YOUR_APP_ID
VITE_ALGOLIA_SEARCH_KEY=YOUR_SEARCH_ONLY_API_KEY
VITE_ALGOLIA_INDEX_NAME=furniture

# Used only by `npm run push` (never exposed to the browser).
ALGOLIA_APP_ID=YOUR_APP_ID
ALGOLIA_ADMIN_KEY=YOUR_ADMIN_API_KEY
ALGOLIA_INDEX_NAME=furniture
